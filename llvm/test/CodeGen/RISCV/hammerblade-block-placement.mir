    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    BEQ $x10, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    liveins: $x10
    $x10 = ADDI $x10, 1
    PseudoRET implicit $x10
  bb.2:
    liveins: $x10
    $x10 = ADDI $x10, 2
    PseudoRET implicit $x10
...
