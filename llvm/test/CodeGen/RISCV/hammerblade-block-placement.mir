body: |
  ; HB-LABEL: name: long_block
  ; HB: bb.0:
  ; HB: bb.2:
  ; HB: bb.1:
  ; GENERIC-LABEL: name: long_block
  ; GENERIC: bb.0:
  ; GENERIC: bb.2:
  ; GENERIC: bb.1:
  bb.0:
    successors: %bb.1(0x10000000), %bb.2(0x70000000)
    liveins: $x10
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
    $x10 = ADDI $x10, 1
